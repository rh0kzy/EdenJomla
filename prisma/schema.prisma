generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Parfum {
  id          Int               @id @default(autoincrement())
  nom         String
  marque      String
  description String?
  image       String?
  notes       String?
  barcode     String?           @unique
  categoryId  Int?
  category    Category?    @relation(fields: [categoryId], references: [id])
  tags        ParfumTag[]
  references  ParfumReference[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String?           @default("system")
  updatedBy   String?           @default("system")
}

model ParfumHistory {
  id          Int      @id @default(autoincrement())
  parfumId    Int
  action      String   // 'CREATE', 'UPDATE', 'DELETE'
  oldData     String?  // JSON string of old data
  newData     String?  // JSON string of new data
  changedBy   String   @default("system")
  createdAt   DateTime @default(now())
}

model Category {
  id          Int      @id @default(autoincrement())
  nom         String   @unique
  description String?
  couleur     String?  // Hex color code
  parfums     Parfum[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id          Int         @id @default(autoincrement())
  nom         String      @unique
  couleur     String?     // Hex color code
  parfums     ParfumTag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ParfumTag {
  id       Int     @id @default(autoincrement())
  parfumId Int
  tagId    Int
  parfum   Parfum  @relation(fields: [parfumId], references: [id], onDelete: Cascade)
  tag      Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([parfumId, tagId])
}

model Fournisseur {
  id         Int               @id @default(autoincrement())
  nom        String
  telephone  String?
  email      String?
  references ParfumReference[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model Client {
  id        Int      @id @default(autoincrement())
  nom       String
  telephone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParfumReference {
  id            Int         @id @default(autoincrement())
  parfumId      Int
  fournisseurId Int
  referenceCode String      @unique
  unite         String
  prixUnitaire  Float
  parfum        Parfum      @relation(fields: [parfumId], references: [id])
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])
  stock         Stock?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Stock {
  id                Int             @id @default(autoincrement())
  parfumReferenceId Int             @unique
  quantite          Float
  reference         ParfumReference @relation(fields: [parfumReferenceId], references: [id])
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
