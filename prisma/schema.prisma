generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Parfum {
  id          Int               @id @default(autoincrement())
  nom         String
  marque      String
  description String?
  image       String?
  notes       String?
  barcode     String?           @unique
  categoryId  Int?
  category    Category?    @relation(fields: [categoryId], references: [id])
  tags        ParfumTag[]
  references  ParfumReference[]
  certifications String?          // Certifications like IFRA, ISO
  msdsUrl        String?          // URL or path to MSDS document
  techSheetUrl   String?          // URL or path to Technical Sheet
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  createdBy   String?           @default("system")
  updatedBy   String?           @default("system")
}

model ParfumHistory {
  id          Int      @id @default(autoincrement())
  parfumId    Int
  action      String   // 'CREATE', 'UPDATE', 'DELETE'
  oldData     String?  // JSON string of old data
  newData     String?  // JSON string of new data
  changedBy   String   @default("system")
  createdAt   DateTime @default(now())
}

model Category {
  id          Int      @id @default(autoincrement())
  nom         String   @unique
  description String?
  couleur     String?  // Hex color code
  parfums     Parfum[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Tag {
  id          Int         @id @default(autoincrement())
  nom         String      @unique
  couleur     String?     // Hex color code
  parfums     ParfumTag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ParfumTag {
  id       Int     @id @default(autoincrement())
  parfumId Int
  tagId    Int
  parfum   Parfum  @relation(fields: [parfumId], references: [id], onDelete: Cascade)
  tag      Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([parfumId, tagId])
}

model Fournisseur {
  id              Int                @id @default(autoincrement())
  nom             String
  telephone       String?
  email           String?
  adresse         String?
  rating          Float?             @default(0)
  reliabilityRate Float?             @default(100)
  avgDeliveryTime Float?             // in days
  notes           String?
  contacts        SupplierContact[]
  documents       SupplierDocument[]
  references      ParfumReference[]
  purchaseOrders  PurchaseOrder[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model SupplierContact {
  id            Int         @id @default(autoincrement())
  nom           String
  fonction      String?
  telephone     String?
  email         String?
  fournisseurId Int
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
}

model SupplierDocument {
  id            Int         @id @default(autoincrement())
  nom           String
  url           String
  type          String?     // 'CONTRACT', 'INVOICE', 'TECHNICAL'
  fournisseurId Int
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
}


model Client {
  id        Int      @id @default(autoincrement())
  nom       String
  telephone String?
  email     String?
  points    Int      @default(0)
  segment   String?  @default("Nouveau") // VIP, Régulier, Nouveau
  notes     String?
  anniversaire DateTime?
  adresses  Address[]
  salesOrders SalesOrder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Address {
  id        Int      @id @default(autoincrement())
  rue       String
  ville     String
  codePostal String?
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)
}

model ParfumReference {
  id            Int         @id @default(autoincrement())
  parfumId      Int
  fournisseurId Int
  referenceCode String      @unique
  unite         String
  prixUnitaire  Float
  prixPar100g   Float?
  parfum        Parfum      @relation(fields: [parfumId], references: [id])
  fournisseur   Fournisseur @relation(fields: [fournisseurId], references: [id])
  stock         Stock?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // Pricing relations
  priceHistory  PriceHistory[]
  priceTiers    PriceTier[]
  purchaseOrderItems PurchaseOrderItem[]
  salesOrderItems    SalesOrderItem[]
}

model Stock {
  id                Int             @id @default(autoincrement())
  parfumReferenceId Int             @unique
  quantite          Float           @default(0)
  seuilMin          Float?          // Seuil minimum pour alertes
  seuilMax          Float?          // Seuil maximum pour alertes
  emplacement       String?         // Emplacement physique
  lot               String?         // Numéro de lot
  datePeremption    DateTime?       // Date de péremption
  reserved          Float           @default(0) // Quantité réservée
  warehouseId       Int?            // Entrepôt
  warehouse         Warehouse?      @relation(fields: [warehouseId], references: [id])
  reference         ParfumReference @relation(fields: [parfumReferenceId], references: [id])
  movements         StockMovement[]
  inventoryLines    InventoryLine[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  stockId   Int
  type      String   // 'IN', 'OUT', 'ADJUSTMENT', 'RESERVATION', 'CANCEL_RESERVATION'
  quantity  Float
  reason    String?
  user      String?  @default("system")
  createdAt DateTime @default(now())
  stock     Stock    @relation(fields: [stockId], references: [id], onDelete: Cascade)
}

model Warehouse {
  id        Int         @id @default(autoincrement())
  nom       String      @unique
  adresse   String?
  stocks    Stock[]
  inventories Inventory[]
}

model Inventory {
  id          Int             @id @default(autoincrement())
  nom         String          // Nom de la session d'inventaire
  description String?
  warehouseId Int?
  warehouse   Warehouse?      @relation(fields: [warehouseId], references: [id])
  status      String          @default("DRAFT") // 'DRAFT', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'
  startedAt   DateTime?
  completedAt DateTime?
  user        String?         @default("system")
  notes       String?
  lines       InventoryLine[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model InventoryLine {
  id            Int         @id @default(autoincrement())
  inventoryId   Int
  inventory     Inventory   @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  stockId       Int
  stock         Stock       @relation(fields: [stockId], references: [id])
  expectedQty   Float       // Quantité attendue selon le système
  countedQty    Float?      // Quantité comptée
  difference    Float?      // Différence (countedQty - expectedQty)
  notes         String?
  scannedAt     DateTime?   // Date de scan
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([inventoryId, stockId])
}

// Price change history for auditing price updates
model PriceHistory {
  id                 Int      @id @default(autoincrement())
  parfumReferenceId  Int
  oldPrice           Float
  newPrice           Float
  reason             String?  // Optional note about why price changed
  changedBy          String   @default("system")
  createdAt          DateTime @default(now())

  parfumReference    ParfumReference @relation(fields: [parfumReferenceId], references: [id], onDelete: Cascade)
}

// Price tiers for quantity-based pricing (discounts)
model PriceTier {
  id                 Int      @id @default(autoincrement())
  parfumReferenceId  Int
  minQty             Int      // inclusive
  maxQty             Int?     // optional upper bound (inclusive)
  price              Float
  createdAt          DateTime @default(now())

  parfumReference    ParfumReference @relation(fields: [parfumReferenceId], references: [id], onDelete: Cascade)
  @@index([parfumReferenceId, minQty, maxQty])
}

model PurchaseOrder {
  id              Int                  @id @default(autoincrement())
  fournisseurId   Int
  fournisseur     Fournisseur          @relation(fields: [fournisseurId], references: [id])
  status          String               @default("PENDING") // PENDING, RECEIVED, CANCELLED
  totalAmount     Float
  receivedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           PurchaseOrderItem[]
}


model PurchaseOrderItem {
  id                Int             @id @default(autoincrement())
  purchaseOrderId   Int
  purchaseOrder     PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  parfumReferenceId Int
  parfumReference   ParfumReference @relation(fields: [parfumReferenceId], references: [id])
  quantite          Float
  prixUnitaire      Float
}

model SalesOrder {
  id          Int              @id @default(autoincrement())
  clientId    Int
  client      Client           @relation(fields: [clientId], references: [id])
  status      String           @default("COMPLETED") // PENDING, COMPLETED, CANCELLED
  totalAmount Float
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       SalesOrderItem[]
}

model SalesOrderItem {
  id                Int             @id @default(autoincrement())
  salesOrderId      Int
  salesOrder        SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  parfumReferenceId Int
  parfumReference   ParfumReference @relation(fields: [parfumReferenceId], references: [id])
  quantite          Float
  prixUnitaire      Float
}
